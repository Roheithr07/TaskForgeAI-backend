# ==============================================================================
# TaskForge AI - Backend .gitignore
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets (CRITICAL: never commit)
.env
.env.*
!.env.example

# Local SQLite databases & WAL logs
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
taskforge.db
taskforge_checkpoints.sqlite*

# Generated documents & artifacts
artifacts/*
!artifacts/.gitkeep

# Unit test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db
