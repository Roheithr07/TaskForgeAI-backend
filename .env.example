# ==============================================================================
# TaskForge AI - Backend Environment Variables
# ==============================================================================

APP_NAME="TaskForge AI"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
JSON_LOGS=false

# Security
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database (Default: local SQLite; or PostgreSQL in production)
# SQLite: sqlite:///./taskforge.db
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/taskforge
DATABASE_URL=sqlite:///./taskforge.db

# Database Connection Pooling (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS & Networking
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Artifacts Directory
ARTIFACTS_DIR=./artifacts
MAX_UPLOAD_SIZE_MB=10
